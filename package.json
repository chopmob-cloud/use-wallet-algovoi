{
  "name": "@algovoi/use-wallet-algovoi",
  "version": "1.0.2",
  "description": "AlgoVoi wallet adapter for @txnlab/use-wallet",
  "author": "AlgoVoi <support@algovoi.co.uk>",
  "license": "MIT",
  "homepage": "https://github.com/chopmob-cloud/use-wallet-algovoi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chopmob-cloud/use-wallet-algovoi.git"
  },
  "bugs": {
    "url": "https://github.com/chopmob-cloud/use-wallet-algovoi/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@txnlab/use-wallet": "^5.0.0-rc.1",
    "algosdk": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@txnlab/use-wallet": "^5.0.0-rc.1",
    "algosdk": "^3.5.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^29.1.1",
    "tsdown": "^0.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "start": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "algorand",
    "voi",
    "algovoi",
    "use-wallet",
    "wallet",
    "blockchain"
  ]
}
